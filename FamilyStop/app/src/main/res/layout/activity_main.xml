<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fs_scherm"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingTop="32dp"
        android:paddingRight="24dp"
        android:paddingBottom="32dp">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="18dp"
            android:contentDescription="@string/fs_titel"
            android:src="@drawable/familystop_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/fs_titel"
            android:textColor="@color/fs_tekst"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp"
            android:gravity="center_horizontal"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/setup_uitleg"
            android:textColor="@color/fs_tekst_dim"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/stap_toegankelijkheid"
            style="@style/StapKnop" />

        <TextView
            android:id="@+id/stap_kluis"
            style="@style/StapKnop" />

        <TextView
            android:id="@+id/samenvatting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/fs_tekst_dim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/restricted_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="?android:attr/selectableItemBackground"
            android:lineSpacingMultiplier="1.25"
            android:padding="14dp"
            android:text="@string/setup_restricted"
            android:textColor="@color/fs_tekst_dim"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
